POSTGRES_PASSWORD=root
POSTGRES_EXTERNAL_PORT=5432
POSTGRES_HOST=postgres  # service's name in docker-compose.yaml
JPA_HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=true
